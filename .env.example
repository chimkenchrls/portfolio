# Copy to .env and add your key locally. Never put the key in assets/data.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787
HOST=127.0.0.1
# Exact website origins allowed to call chat, separated by commas.
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Per-server process limit; resets on restart. Add host-level limits before public use.
DAILY_CHAT_LIMIT=100
